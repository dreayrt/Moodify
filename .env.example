# ==============================================================================
# MOODIFY FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Sao chép file này thành .env.local trên môi trường Dev
# ==============================================================================

# URL kết nối tới Spring Boot Backend (mặc định 8080)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Google OAuth Client ID (tùy chọn, điền nếu muốn dùng tính năng Google Login)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
